<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - ChessPlatform</title>
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/ChessPlatform.styles.css" asp-append-version="true" />
</head>
<body class="site-body @ViewData["BodyClass"]">
    <header>
        <nav class="navbar navbar-expand-sm chess-navbar border-bottom box-shadow mb-3">
            <div class="container-fluid">
                <a class="navbar-brand chess-brand" asp-area="" asp-controller="Home" asp-action="Index">
                    <img src="~/images/chessLogo.jpg" alt="ChessPlatform" class="chess-logo"/>
                    <span>ChessPlatform</span>
                </a>

                <div class="navbar-nav ms-auto">

                    @if (User.Identity?.IsAuthenticated == true)
                    {
                        @if (User.IsInRole("Admin"))
                        {
                            <a asp-controller="Admin" asp-action="Index" class="btn btn-outline-primary me-2">
                                Dashboard
                            </a>
                        }
                        else if (User.IsInRole("Organizer"))
                        {
                            <a asp-controller="Tournament" asp-action="Index" class="btn btn-outline-primary me-2">
                                Dashboard
                            </a>
                        }
                        else if (User.IsInRole("Player"))
                        {
                            <a asp-controller="Player" asp-action="Index" class="btn btn-outline-primary me-2">
                                Dashboard
                            </a>
                        }

                        <form asp-controller="Account" asp-action="Logout" method="post" class="d-inline">

                            @Html.AntiForgeryToken()

                            <button type="submit" class="btn btn-outline-danger">
                                Logout
                            </button>

                        </form>
                    }

                </div>
            </div>
        </nav>
    </header>
   <div class="container">
        <main role="main" class="pb-3 site-main">
            @RenderBody()
        </main>
    </div>
        @if (ViewData["HideFooter"] as bool? != true)
        {
            <footer class="chess-footer">
                <div class="chess-footer-content">
                    <div class="chess-footer-brand">
                        <span class="chess-footer-piece">♟</span>
                        <span>ChessPlatform</span>
                    </div>

                    <p>Chess tournament management system</p>

                    <span class="chess-footer-copy">
                        © 2026 ChessPlatform
                    </span>
                </div>
            </footer>
        }
        <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
