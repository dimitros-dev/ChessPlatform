@model List<Tournament>

	<link rel="stylesheet" href="~/css/app.css"/>

@{
	var joinedIds = ViewBag.JoinedIds as List<int>;
}
<div class="container mt-4">

	<h2 style="color:antiquewhite">Available tournaments</h2>

	<div class="card">
		<div class="card-body p-0">

			<table class="table table-hover mb-0">
				<thead class ="table-dark">
					<tr>
						<th>Name</th>
						<th>Description</th>
						<th></th>
					</tr>
				</thead>
				<tbody>
					@foreach(var tournament in Model)
					{
						<tr>
							<td>@tournament.Name</td>
							<td>@tournament.Description</td>
							<td>
								@if (joinedIds != null && joinedIds.Contains(tournament.Id))
								{
									<span class="text-success">Joined</span>
									<a asp-controller="Tournament" asp-action="Leave" asp-route-id="@tournament.Id"
										class="btn btn-sm btn-danger">
										Leave
									</a>
								}
								else{
									<a asp-controller="Tournament" asp-action="Join" asp-route-id="@tournament.Id"
										class="btn btn-sm btn-primary">
										Join
									</a>
								}
							</td>
						</tr>
					}
				</tbody>
			</table>
		</div>
	</div>
</div>