@model List<Match>

<link rel="stylesheet" href="~/css/app.css" />

@{
    var userId = ViewBag.UserId as string;
}

<div class="my-matches-page">

    <div class="my-matches-header">
        <div class="my-matches-header-icon">♟</div>

        <div>
            <h1>My Matches</h1>
            <p>View your matches, opponents and game results.</p>
        </div>
    </div>

    @if (!Model.Any())
    {
        <div class="my-matches-empty">
            <div class="my-matches-empty-icon">♟</div>

            <h2>No matches yet</h2>

            <p>
                You don't have any matches yet.
                Join a tournament and start playing.
            </p>

            <a asp-controller="Player" asp-action="Tournaments" class="my-matches-button">
                Browse Tournaments
            </a>
        </div>
    }
    else
    {
        <div class="my-matches-card">

            <table class="my-matches-table">
                <thead>
                    <tr>
                        <th>Opponent</th>
                        <th>Color</th>
                        <th>Status</th>
                        <th>Result</th>
                        <th>Action</th>
                    </tr>
                </thead>

                <tbody>

                    @foreach (var match in Model)
                    {
                        var isPlayer1 = match.Player1Id == userId;

                        <tr>

                            <td class="match-opponent">
                                <span class="match-player-icon">♟</span>

                                <strong>
                                    @(isPlayer1
                                        ? match.Player2.UserName
                                        : match.Player1.UserName)
                                </strong>
                            </td>

                            <td>
                                @if (isPlayer1)
                                {
                                    <span class="match-color white">
                                        ♔ White
                                    </span>
                                }
                                else
                                {
                                    <span class="match-color black">
                                        ♚ Black
                                    </span>
                                }
                            </td>

                            <td>
                                @if (match.IsFinished)
                                {
                                    <span class="match-status finished">
                                        Finished
                                    </span>
                                }
                                else
                                {
                                    <span class="match-status active">
                                        Active
                                    </span>
                                }
                            </td>

                            <td class="match-result">
                                @if (match.IsFinished)
                                {
                                    @if (match.Result == "WhiteWin")
                                    {
                                        <span>White Win</span>
                                    }
                                    else if (match.Result == "BlackWin")
                                    {
                                        <span>Black Win</span>
                                    }
                                    else if (match.Result == "Draw")
                                    {
                                        <span>Draw</span>
                                    }
                                }
                                else
                                {
                                    <span class="result-pending">
                                        —
                                    </span>
                                }
                            </td>

                            <td>
                                <a asp-controller="Match" asp-action="Details" asp-route-id="@match.Id"
                                   class="match-open-button">
                                    Open Match
                                </a>
                            </td>

                        </tr>
                    }

                </tbody>

            </table>

        </div>
    }

</div>

