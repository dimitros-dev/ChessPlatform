@model List<(ApplicationUser User, IList<string> Roles)>

@{
	ViewData["BodyClass"] = "admin-users";
}
<link rel="stylesheet" href="~/css/app.css"/>

<div class="container mt-4">

	<h1 class="mb-4" style="color:antiquewhite">Users </h1>

	<div class="card">

		<table class="table table-hover mb-0">
			<thead class ="table-dark">
			<tr>
				<th>Username</th>
				<th>Email</th>
				<th>Roles</th>
				<th></th>
			</tr>
			</thead>
			<tbody>

		@foreach(var item in Model){
			<tr>
				<td>@item.User.UserName</td>
				<td>@item.User.Email</td>
					
				<td>
					@foreach(var role in item.Roles)
					{
						<span class="badge bg-primary me-1">@role</span>		
					}
				</td>
				<td>
					<a href="/Admin/ChangeRole?userId=@item.User.Id&role=Admin">Admin only</a>|
					<a href="/Admin/ChangeRole?userId=@item.User.Id&role=Organizer">Organizer only</a>|
					<a href="/Admin/ChangeRole?userId=@item.User.Id&role=Player">Player only</a>
				
				</td>
				<td>
					<a asp-action="DeleteUser" asp-route-id="@item.User.Id" class="text-danger"
								   onclick="return confirm('Delete this user?')">Delete</a>
				</td>
			</tr>
		}
			</tbody>
		</table>
	</div>
</div>
