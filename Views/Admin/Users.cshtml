@model List<(ApplicationUser User, IList<string> Roles)>

@{
    ViewData["BodyClass"] = "admin-users";
}

<link rel="stylesheet" href="~/css/app.css" />

<div class="admin-users-page">
    <div class="admin-section-header">
        <h1>Users</h1>
        <p>Manage registered users and their roles.</p>
    </div>
    <div class="users-table-container">
        <table class="users-table">
            <thead>
                <tr>
                    <th>Username</th>
                    <th>Email</th>
                    <th>Current Role</th>
                    <th>Change Role</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>

                @foreach (var item in Model)
                {
                    <tr>
                        <td class="username-cell">
                            <span class="user-icon">♟</span>
                            @item.User.UserName
                        </td>

                        <td>
                            @item.User.Email
                        </td>

                        <td>
                            @foreach (var role in item.Roles)
                            {
                                <span class="role-badge">
                                    @role
                                </span>
                            }
                        </td>
                        <td>

                            <a asp-action="ChangeRole" asp-route-userId="@item.User.Id" asp-route-role="Admin" class="role-button">                            
                                Admin
                            </a>

                            <a asp-action="ChangeRole" asp-route-userId="@item.User.Id" asp-route-role="Organizer" class="role-button">                            
                                Organizer
                            </a>

                            <a asp-action="ChangeRole" asp-route-userId="@item.User.Id" asp-route-role="Player" class="role-button">
                                Player
                            </a>

                        </td>

                        <td>
                            <a asp-action="DeleteUser" asp-route-id="@item.User.Id" class="delete-button" onclick="return confirm('Delete this user?')">
                                Delete
                            </a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
        @if (TempData["Error"] != null)
        {
            <script>
                alert("@TempData["Error"]");
            </script>
        }
    </div>
</div>
