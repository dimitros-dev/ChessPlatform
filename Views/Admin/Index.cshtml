@{
    ViewData["BodyClass"] = "admin-dashboard";
}

<link rel="stylesheet" href="~/css/app.css" />

<div class="admin-page">

    <div class="admin-header text-center">
        <h1>Admin Dashboard</h1>
        <p>Manage users, tournaments and the ChessPlatform system.</p>
    </div>

    <div class="admin-cards">

        <div class="admin-card">
            <div class="admin-card-icon">♟</div>

            <h2>Users</h2>

            <p>
                Manage registered users, assign roles
                and maintain user accounts.
            </p>

            <a asp-controller="Admin"
               asp-action="Users"
               class="admin-card-button">
                Manage Users
            </a>
        </div>

        <div class="admin-card">
            <div class="admin-card-icon">🏆</div>

            <h2>Tournaments</h2>

            <p>
                View and manage tournaments created
                on the ChessPlatform.
            </p>

            <a asp-controller="Admin"
               asp-action="Tournaments"
               class="admin-card-button">
                Manage Tournaments
            </a>
        </div>

    </div>

</div>
