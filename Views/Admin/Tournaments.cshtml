@model List<Tournament>

@{
    ViewData["BodyClass"] = "admin-tournaments";
}

<link rel="stylesheet" href="~/css/app.css" />

<div class="admin-tournaments-page">

    <div class="admin-section-header">
        <h1>All Tournaments</h1>
        <p>View and manage tournaments created on the platform.</p>
    </div>

    <div class="tournaments-table-container">
        <table class="tournaments-table">
            <thead>
                <tr>
                    <th>Name</th>
                    <th>Description</th>
                    <th>Created By</th>
                    <th>Actions</th>
                </tr>
            </thead>

            <tbody>

                @foreach (var t in Model)
                {
                    <tr>

                        <td class="tournament-name">
                            <span class="tournament-icon">♟</span>
                            @t.Name
                        </td>

                        <td class="tournament-description">
                            @t.Description
                        </td>

                        <td>
                            @t.CreatedBy.UserName
                        </td>

                        <td>
                            <a asp-action="DeleteTournament"
                               asp-route-id="@t.Id"
                               class="delete-button"
                               onclick="return confirm('Delete this tournament?')">
                                Delete
                            </a>
                        </td>

                    </tr>
                }

            </tbody>
        </table>
    </div>
</div>
