@model List<Tournament>

<link rel="stylesheet" href="~/css/app.css" />
         
<div class="container mt-4">

    <h2 class ="mb-4" style="color:antiquewhite">All Tournaments</h2>

    <div class="card">
        <div class="card-body p-0">

            <table class ="table table-hover mb-0">
                <thead class="table-dark">
                    <tr>
                        <th>Name</th>
                        <th>Description</th>
                        <th>Created By</th>
                        <th>Actions</th>
                    </tr>
                </thead>

                <tbody>
                    @foreach (var t in Model)
                    {
                        <tr>
                            <td>@t.Name</td>
                            <td>@t.Description</td>
                            <td>@t.CreatedBy.UserName</td>
                            <td>
                                <a asp-action="DeleteTournament" asp-route-id="@t.Id" class="text-danger"
                                               onclick="return confirm('Delete this tournament?')">Delete</a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

     </div>
</div>
