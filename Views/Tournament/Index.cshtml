@model List<Tournament>

<link rel="stylesheet" href="~/css/app.css" />

<div class="organizer-tournaments-page">

    <div class="organizer-tournaments-header">
        <div>
            <h1>My Tournaments</h1>
            <p>Manage your tournaments and track their progress.</p>
        </div>

        <a asp-controller="Tournament"
           asp-action="Create"
           class="create-tournament-button">
            + Create Tournament
        </a>
    </div>

    @if (!Model.Any())
    {
        <div class="empty-tournaments-card">
            <div class="empty-icon">♟</div>
            <h2>No tournaments yet</h2>
            <p>You haven't created any tournaments yet.</p>

            <a asp-controller="Tournament"
               asp-action="Create"
               class="create-tournament-button">
                Create Your First Tournament
            </a>
        </div>
    }
    else
    {
        <div class="organizer-tournaments-table-container">

            <table class="organizer-tournaments-table">
                <thead>
                    <tr>
                        <th>Name</th>
                        <th>Description</th>
                        <th>Tournament Type</th>
                        <th>Start</th>
                        <th>End</th>
                        <th>Status</th>
                        <th>Actions</th>
                    </tr>
                </thead>

                <tbody>

                    @foreach (var t in Model)
                    {
                        <tr>

                            <td class="tournament-name-cell">
                                <strong>@t.Name</strong>
                            </td>

                            <td class="tournament-description-cell">
                                @t.Description
                            </td>

                            <td class="tournament-type-cell">

                                @if (t.TournamentType == "Classical")
                                {
                                    <span class="tournament-type-icon"
                                          title="Classical">🐢</span>
                                }
                                else if (t.TournamentType == "Rapid")
                                {
                                    <span class="tournament-type-icon"
                                          title="Rapid">🐇</span>
                                }
                                else if (t.TournamentType == "Blitz")
                                {
                                    <span class="tournament-type-icon"
                                          title="Blitz">⚡</span>
                                }
                                else if (t.TournamentType == "Bullet")
                                {
                                    <span class="tournament-type-icon"
                                          title="Bullet">🔫</span>
                                }

                                <span class="tournament-type-name">
                                    @t.TournamentType
                                </span>

                            </td>
                            <td>
                                @t.StartDate.ToShortDateString()
                            </td>
                            <td>
                                @t.EndDate.ToShortDateString()
                            </td>
                            <td>

                                @if (!t.IsStarted)
                                {
                                    <span class="tournament-status not-started">
                                        Not started
                                    </span>
                                }
                                else
                                {
                                    <span class="tournament-status started">Started</span>                               
                                }
                            </td>
                            <td class="tournament-actions">

                                @if (!t.IsStarted)
                                {
                                    <form asp-action="Start" method="post" class="d-inline"> 
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="id" value="@t.Id" />
                                        <button type="submit" class="tournament-action-button start-button">Start</button>                                                                                                                                  
                                    </form>
                                }

                                <a asp-controller="Tournament" asp-action="Standings" asp-route-id="@t.Id" class="tournament-action-button standings-button">                                                                
                                    Standings
                                </a>

                                <form asp-action="Delete" method="post" class="d-inline" onsubmit="return confirm('Delete this tournament?')">   
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="id" value="@t.Id" />                                                                                   
                                    <button type="submit" class="tournament-action-button delete-button">Delete</button>                                                                                                                  
                                </form>

                            </td>

                        </tr>
                    }

                </tbody>

            </table>

        </div>
    }

</div>

