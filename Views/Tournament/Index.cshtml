@model List<Tournament>

    <link rel="stylesheet" href="~/css/app.css" />

<div class="container mt-4">

    <h1 class="mb-3">My tournaments</h1>

    <a asp-controller="Tournament" asp-action="Create" class="btn btn-primary mb-3">
    Create Tournament
    </a>

    <hr />

    @if (!Model.Any())
    {
        <div class="alert alert-info">
            You don't have any tournaments yet.
        </div>
    }
    else
    {
        <table class="table table-striped table-hover">
            <thead class="table-dark">
                <tr>
                    <th>Name</th>
                    <th>Description</th>
                    <th>Start</th>
                    <th>End</th>
                    <th>Action</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var t in Model)
                {
                    <tr>
                        <td>@t.Name</td>
                        <td>@t.Description</td>
                        <td>@t.StartDate.ToShortDateString()</td>
                        <td>@t.EndDate.ToShortDateString()</td>
                        <td>
                            @if (!t.IsStarted)
                            {
                                <span class="text-warning">Not started</span>
                            }
                            else
                            {
                                <span class="text-success">Started</span>
                            }
                        </td>
                        <td>
                            <a asp-action="Delete"
                               asp-route-id="@t.Id" class="text-danger" 
                               onclick="return confirm('Delete this tournament?')">
                                Delete
                            </a>
                        
                        @if (!t.IsStarted)
                        {
                            <a asp-action="Start"
                               asp-route-id="@t.Id"
                               class="btn btn-sm btn-success ms-2">
                                Start
                            </a>
                        }
                        </td>
                    </tr>
                   
                }
            </tbody>
        </table>
    }
</div>
